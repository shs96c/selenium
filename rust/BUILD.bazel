load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "selenium-manager",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = all_crate_deps(normal = True),
)

platform_transition_filegroup(
    name = "selenium-manager-linux-x86_64",
    srcs = [":selenium-manager"],
    target_platform = "//common:linux_x86_64",
)

platform_transition_filegroup(
    name = "selenium-manager-macos-arm64",
    srcs = [":selenium-manager"],
    target_platform = "//common:macos_arm64",
)

platform_transition_filegroup(
    name = "selenium-manager-macos-x86_64",
    srcs = [":selenium-manager"],
    target_platform = "//common:macos_x86_64",
)

platform_transition_filegroup(
    name = "selenium-manager-windows-x86_64",
    srcs = [":selenium-manager"],
    target_platform = "//common:windows_x86_64",
)
