cc_library(
    name = "iconv",
    srcs = glob([
        "ccs/*.c",
        "ces/*.c",
        "lib/*.c",
        "util/*.c",
    ]),
    hdrs = glob([
        "lib/*.h",
        "include/*.h",
        "util/*.h",
    ]),
    includes = [
        "./include/",
        "./lib/",
    ],
    copts = [
        "-Wno-int-conversion",
    ],
    deps = [
        "@apr//:apr",
        "@selenium//third_party/cpp/apr-iconv:apr-iconv-generated",
    ],
    visibility = [
        "@selenium//rust:__pkg__",
    ],
)
